// TEMPORARY security rules — placeholder until real authentication is wired in.
// TODO: Replace with authenticated rules once Scorer auth is implemented.
//
// Intended final behaviour:
//   - Anyone can read matches, tournaments, teams, players (spectator access).
//   - Only an authenticated Scorer can CREATE / UPDATE / DELETE match data.
//   - A match can only be written by the scorer who created it (scorerId field).

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public read, restricted write (by scorerId field — placeholder).
    match /matches/{matchId} {
      allow read: if true;
      allow create: if request.auth != null;   // TEMP: open to all authenticated
      allow update: if request.auth != null;   // TEMP: open to all authenticated
      allow delete: if request.auth != null;   // TEMP: open to all authenticated
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /tournaments/{tournamentId}/teams/{teamId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /players/{playerId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
