// Scorer access rules.
//
// Owner/co-owner restrictions on editing and deleting tournaments, matches,
// teams, players and related data have been REMOVED. Any signed-in user may
// now create/update/delete scorer data. Reads remain open to everyone
// (signed-in or anonymous) in both the scorer and spectator views.
//
// Note on structure: this app stores `teams`, `players`, `matches` and
// `scorer_schedules` as TOP-LEVEL collections (teams/players/matches carry a
// `tournamentId` field; `scorer_schedules` uses the tournament id as its
// document id).

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Scorer data is fully writable by any signed-in user (ownership checks
    // were removed). Reads stay open to everyone.
    function canWriteScorerData() {
      return isSignedIn();
    }

    // ── Tournaments ────────────────────────────────────────────────────────
    match /tournaments/{tournamentId} {
      allow read: if true; // anyone can view tournament details / settings
      allow create: if canWriteScorerData();
      allow update, delete: if canWriteScorerData();

      // Per-tournament schedule (if it is ever stored as a subcollection).
      match /schedule/{scheduleId} {
        allow read: if true;
        allow write: if canWriteScorerData();
      }
    }

    // ── Matches ────────────────────────────────────────────────────────────
    match /matches/{matchId} {
      allow read: if true;
      allow create: if canWriteScorerData();
      allow update, delete: if canWriteScorerData();
    }

    // ── Teams ──────────────────────────────────────────────────────────────
    match /teams/{teamId} {
      allow read: if true;
      allow create: if canWriteScorerData();
      allow update: if canWriteScorerData();
      allow delete: if canWriteScorerData();
      allow list: if true;
    }

    // ── Players ────────────────────────────────────────────────────────────
    match /players/{playerId} {
      allow read: if true;
      allow create: if canWriteScorerData();
      allow update: if canWriteScorerData();
      allow delete: if canWriteScorerData();
      allow list: if true;
    }

    // ── Schedules (document id == tournament id) ───────────────────────────
    match /scorer_schedules/{tournamentId} {
      allow read: if true;
      allow write: if canWriteScorerData();
    }

    // ── User profiles: each user can read/write their own document ─────────
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // ── User devices (FCM tokens): owner-only, read by the Cloud Function
    //    sender via the Admin SDK (which bypasses rules). ───────────────────
    match /users/{userId}/devices/{deviceId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // ── Match alert subscriptions (per match): owner-only. ─────────────────
    match /users/{userId}/matchAlerts/{matchId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Deny everything else unless explicitly allowed above.
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}