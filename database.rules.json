     Intended final behaviour:
       - Anyone can read live match data (spectator streaming).
       - Only an authenticated Scorer can write to /liveMatches/{matchId}.
  */
  "rules": {
    "liveMatches": {
      ".read": true,
      ".write": "auth != null",
      "$matchId": {
        ".read": true,
        ".write": "auth != null"
      }
    }
  }
}
